# Frontend environment configuration template

# HTTP API Endpoint URL (must point to backend endpoint — used by browser code)
VITE_API_URL="http://localhost:5003"

# Real-time WebSocket Endpoint URL (must point to backend Socket.io server — used by browser code)
VITE_SOCKET_URL="http://localhost:5003"

# Feature Flags
# Set to true to enable EMOS Brand Vault features (event log, snapshots, context contract)
# Must also set EMOS_BRAND_VAULT_ENABLED=true in backend .env
VITE_EMOS_BRAND_VAULT_ENABLED=false

# ── Docker-readiness controls ───────────────────────────────────────────────
# BACKEND_PROXY_TARGET
#   The URL that the Vite dev server uses as the proxy target for /api requests.
#   This is a SERVER-SIDE Vite configuration variable — it is NOT prefixed with
#   VITE_ intentionally and is never exposed to browser-executed code.
#
#   Native development (default — no override needed):
#     BACKEND_PROXY_TARGET=http://127.0.0.1:5003
#
#   Docker Compose development (frontend container → backend container):
#     BACKEND_PROXY_TARGET=http://backend:5003
#
# BACKEND_PROXY_TARGET=http://127.0.0.1:5003

