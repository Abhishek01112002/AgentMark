# Frontend environment configuration template

# HTTP API Endpoint URL (must point to backend endpoint)
VITE_API_URL="http://localhost:5003"

# Real-time WebSocket Endpoint URL (must point to backend Socket.io server)
VITE_SOCKET_URL="http://localhost:5003"

# Feature Flags
# Set to true to enable EMOS Brand Vault features (event log, snapshots, context contract)
# Must also set EMOS_BRAND_VAULT_ENABLED=true in backend .env
VITE_EMOS_BRAND_VAULT_ENABLED=false
