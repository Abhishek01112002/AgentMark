PORT=5003
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmark?connection_limit=10"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
NODE_ENV="development"

# AI Service Configuration
AI_SERVICE_URL="http://127.0.0.1:5002"
INTERNAL_SERVICE_SECRET="change-this-shared-backend-ai-service-secret"

# Redis Configuration (For FastAPI agent orchestration synchronization)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL (For Socket.io CORS authorization)
FRONTEND_URL=http://localhost:5173

# ImageKit Configuration (Optional, for visual asset storage)
IMAGEKIT_URL_ENDPOINT="your_imagekit_url_endpoint"
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"

# LLM API Keys (Default fallbacks if user-specific keys are not supplied in headers)
OPENAI_API_KEY="your_openai_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# Feature Flags & System Options
ENABLE_CREATIVE_HOOK_MATRIX=true
MAX_CONCURRENT_SIMULATIONS=5
EMOS_BRAND_VAULT_ENABLED=true
