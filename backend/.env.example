PORT=5003
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmark?connection_limit=10"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
NODE_ENV="development"

# AI Service Configuration
AI_SERVICE_URL="http://127.0.0.1:5002"
INTERNAL_SERVICE_SECRET="change-this-shared-backend-ai-service-secret"

# Redis Configuration (For FastAPI agent orchestration synchronization)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL (For Socket.io CORS authorization)
FRONTEND_URL=http://localhost:5173

# ImageKit Configuration (Optional, for visual asset storage)
IMAGEKIT_URL_ENDPOINT="your_imagekit_url_endpoint"
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"

# LLM API Keys (Default fallbacks if user-specific keys are not supplied in headers)
OPENAI_API_KEY="your_openai_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# Feature Flags & System Options
ENABLE_CREATIVE_HOOK_MATRIX=true
MAX_CONCURRENT_SIMULATIONS=5
EMOS_BRAND_VAULT_ENABLED=true

# ── $0-Cost Logging Strategy ────────────────────────────────────────────────
# DEVELOPMENT: Leave as INFO (see console output while coding)
# PRODUCTION:  Set to ERROR — suppresses 99% of logs at runtime, zero disk/CPU waste
#              Cost: $0.00 — no paid log-ingestor needed
LOG_LEVEL=INFO

# ── Free Crash Tracking (Sentry Developer Plan — $0/month, 5,000 errors/mo) ──
# 1. Sign up at https://sentry.io (free, no credit card)
# 2. Create a "Node.js" project → copy DSN from Settings > Client Keys
# 3. Paste DSN below — ONLY real crashes (uncaught exceptions) will be sent
# Leave empty in development: SENTRY_DSN=
SENTRY_DSN=

# ── Docker-readiness controls ───────────────────────────────────────────────
# CLAUDE_DESKTOP_DISABLED
#   Set to "true" to forcibly disable Claude Desktop config-management endpoints.
#   On Linux/containers this is automatic (detected via os.platform()).
#   On Windows/macOS this can be used to simulate a container environment in tests.
#   Native development: leave unset or set to "false"
#   Docker containers:  set to "true" (or rely on automatic Linux detection)
# CLAUDE_DESKTOP_DISABLED=true

# DB_STARTUP_MAX_RETRIES
#   Number of times the backend probes PostgreSQL before aborting startup.
#   Default: 10. Increase for slow Postgres or high-latency networks.
# DB_STARTUP_MAX_RETRIES=10

# DB_STARTUP_RETRY_DELAY_MS
#   Milliseconds to wait between PostgreSQL readiness probes.
#   Default: 2000 (2 seconds). Adjust alongside DB_STARTUP_MAX_RETRIES.
# DB_STARTUP_RETRY_DELAY_MS=2000

