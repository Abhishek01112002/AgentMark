// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  
  projects  Project[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("active") // active, idle, archived
  
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  campaigns       Campaign[]
  memorySnapshots CampaignMemorySnapshot[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Campaign {
  id              String   @id @default(uuid())
  name            String
  brandName       String?
  industry        String
  primaryGoal     String
  targetAudience  String   @db.Text
  brandVoice      String
  
  status          String   @default("draft")
  reviewScore     Float?   // AI review agent score (0-10)
  reviewOutput    String?  @db.Text // Full review output JSON with individual agent scores
  
  // AI Service Integration
  aiCampaignId    String?  // FastAPI campaign ID
  aiOutputs       Json?    // All 7 agent outputs (manager, research, strategy, copy, image, review, publisher)
  aiError         String?  @db.Text // Error message if AI workflow fails
  
  // HITL (Human-In-The-Loop) Fields
  researchRevisionCount  Int?     @default(0)
  strategyRevisionCount  Int?     @default(0)
  copyRevisionCount      Int?     @default(0)
  imageRevisionCount     Int?     @default(0)
  humanApprovalStatus    String?  // 'pending', 'approved', 'rejected'
  humanFeedback          String?  @db.Text
  humanRevisionTarget    String?  // 'research', 'strategy', 'copywriter', 'image_prompt'
  
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  memorySnapshot  CampaignMemorySnapshot?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("campaigns")
}

model CampaignMemorySnapshot {
  id                      String   @id @default(uuid())

  projectId               String
  project                 Project  @relation(fields: [projectId], references: [id])

  campaignId              String   @unique
  campaign                Campaign @relation(fields: [campaignId], references: [id])

  finalReviewScore        Float?
  humanApprovedOnFirstTry Boolean  @default(false)

  rejectionReasons        Json?    // [{ targetAgent: string, feedbackText: string }]
  finalApprovedTone       String[] // Postgres native array
  finalChannelsUsed       String[]

  completedAt             DateTime @default(now())

  @@index([projectId, completedAt])
  @@map("campaign_memory_snapshots")
}
