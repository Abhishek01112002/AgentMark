# LLM API Keys (Will be used as default fallback keys if user-specific settings are not configured in frontend)
OPENAI_API_KEY="your_openai_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
TAVILY_API_KEY="tvly-xxxxxxxxxxxxxxxx"

# Model Configuration Settings
GROQ_MODEL="llama-3.3-70b-versatile"
COPYWRITER_MODEL="llama-3.3-70b-versatile"

# Service Configuration (Supports both PORT/SERVICE_PORT and HOST/SERVICE_HOST)
PORT=5002
SERVICE_PORT=5002
HOST=127.0.0.1
SERVICE_HOST=127.0.0.1
INTERNAL_SERVICE_SECRET="change-this-shared-backend-ai-service-secret"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Feature Flags & Concurrency Controls
ENABLE_CREATIVE_HOOK_MATRIX=true
MAX_CONCURRENT_SIMULATIONS=5
EMOS_BRAND_VAULT_ENABLED=true

# ── $0-Cost Logging Strategy ────────────────────────────────────────────────
# DEVELOPMENT: INFO (verbose, helpful for debugging)
# PRODUCTION:  ERROR — Python logging module silently ignores INFO/DEBUG at runtime
#              Logs go to stdout only (Docker/PM2 captures free). No file writes in prod.
LOG_LEVEL=INFO

# ── Free Crash Tracking (Sentry Developer Plan — $0/month, 5,000 errors/mo) ──
# 1. Sign up at https://sentry.io (free, no credit card)
# 2. Create a "Python (FastAPI)" project → copy DSN
# 3. Only uncaught exceptions will be sent. Routine logs stay local.
SENTRY_DSN=
